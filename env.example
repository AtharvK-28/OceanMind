# ── Copy this to .env and fill in your values ─────────────────────────────────

# PostgreSQL (PostGIS must be enabled on this DB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oceanmind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Groq API (free at console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# GFW (Global Fishing Watch) - optional for MVP fallback mode
GFW_API_KEY=

# CMEMS (Copernicus Marine) - optional for MVP fallback mode
CMEMS_USER=
CMEMS_PASSWORD=

# App config
APP_ENV=development
FALLBACK_DATA_MODE=true   # use pre-loaded fallback data instead of live APIs
