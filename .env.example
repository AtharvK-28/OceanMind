# OceanMind — Environment Configuration
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# ── PostgreSQL / PostGIS ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oceanmind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ── RAG (OpenRouter LLM) ──────────────────────────────────────────────────────────────
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=
# Optional: override the default model (free tier: add :free suffix)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional: shown in OpenRouter dashboard for usage tracking
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=OceanMind

# ── Data Sources (optional — synthetic fallback used if not set) ──────────────
GFW_API_KEY=

# ── Alerts (Phase 2 — leave blank for MVP) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FIREBASE_SERVER_KEY=
