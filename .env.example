# OceanMind — Environment Configuration
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# ── PostgreSQL / PostGIS ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oceanmind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ── RAG (Groq LLM) ───────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# ── Data Sources (optional — synthetic fallback used if not set) ──────────────
GFW_API_KEY=

# ── Alerts (Phase 2 — leave blank for MVP) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FIREBASE_SERVER_KEY=
