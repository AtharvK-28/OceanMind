# OceanMind — Environment Configuration
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# ── PostgreSQL / PostGIS ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oceanmind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ── RAG (Groq LLM) ───────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# ── Data Sources (optional — synthetic fallback used if not set) ──────────────
GFW_API_KEY=

# ARGO float data (Argovis API) — no key required, this only raises rate limits
ARGOVIS_API_KEY=

# Chlorophyll-a (Copernicus Marine Service) — free account required:
# register at https://data.marine.copernicus.eu, then `pip install copernicusmarine`
COPERNICUSMARINE_USERNAME=
COPERNICUSMARINE_PASSWORD=
CMEMS_CHLOROPHYLL_DATASET_ID=cmems_obs-oc_glo_bgc-plankton_nrt_l4-gapfree-multi-4km_P1D

# Set to false to enable live data (ARGO, GFW, INCOIS-SST) instead of synthetic fallback
FALLBACK_DATA_MODE=true

# ── Native app / frontend build (frontend-react/.env.local) ──────────────────
# Baked into the web bundle at build time (also into the Android APK via
# `npm run build:native`). For a phone build, point the API at a reachable
# host — a phone cannot see your laptop's localhost.
# NEXT_PUBLIC_API_URL=http://192.168.1.50:8000
# Emergency number for the SOS button. In the native app the SMS is sent
# directly to this number; on the web it pre-addresses the composer.
# NEXT_PUBLIC_EMERGENCY_SMS_NUMBER=+911234567890

# ── Alerts (Phase 2 — leave blank for MVP) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FIREBASE_SERVER_KEY=
